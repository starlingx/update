#
# Bash completion for the unified software management CLI.
# Commands are hardcoded for instant completion without Python invocation.
#

_software_opts="list show upload upload-dir delete is-available is-deployed is-committed install-local deploy system-deploy metapackage help"
_software_deploy_opts="show host-list select unselect precheck start host host-rollback abort activate activate-rollback complete delete help"
_software_system_deploy_opts="init show delete help"
_software_metapackage_opts="list help"

_software()
{
    local cur prev cmd
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd="${COMP_WORDS[1]}"

    if [ "$cmd" == "deploy" ] ; then
        COMPREPLY=($(compgen -W "${_software_deploy_opts}" -- ${cur}))
    elif [ "$cmd" == "system-deploy" ] ; then
        COMPREPLY=($(compgen -W "${_software_system_deploy_opts}" -- ${cur}))
    elif [ "$cmd" == "metapackage" ] ; then
        COMPREPLY=($(compgen -W "${_software_metapackage_opts}" -- ${cur}))
    else
        COMPREPLY=($(compgen -W "${_software_opts}" -- ${cur}))
    fi

    return 0
}

complete -F _software software
